{
  "name": "unai",
  "version": "0.1.0",
  "private": true,
  "description": "Uai - universal memory system (memory kernel). Built by moe-next agents from prd.md.",
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
