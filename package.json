    "check:phase-exit": "pnpm typecheck && pnpm test && pnpm validate:registry"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
