{
  "name": "unai",
  "version": "0.1.0",
  "private": true,
  "description": "Uai - universal memory system (memory kernel). Built by moe-next agents from prd.md.",
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "lint": "pnpm typecheck && pnpm exec vitest run src/architecture.test.ts src/boundaries.test.ts",
    "ops:report": "tsx src/operations/report.ts",
    "check:v0-release": "tsx src/operations/report.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @unai/web typecheck",
    "build": "pnpm --filter @unai/web build",
    "dev:web": "pnpm --filter @unai/web dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "start:web": "pnpm --filter @unai/web start",
    "start:api": "tsx packages/api/src/server.ts",
    "start:worker": "tsx packages/api/src/processing-worker.ts",
    "db:migrate": "tsx packages/postgres/src/migrate-cli.ts",
    "uai": "tsx packages/registry/src/cli.ts",
    "validate:registry": "tsx packages/registry/src/cli.ts registry lint",
    "check:phase-exit": "pnpm typecheck && pnpm test && pnpm validate:registry && pnpm uai registry test && pnpm uai corpus run --corpus synthetic && pnpm uai corpus verify",
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.0.0",
    "axe-core": "4.13.0",
    "jsdom": "26.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
