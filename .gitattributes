# Registry release files are hashed byte-for-byte; never convert line endings.
registry/releases/** -text
registry/releases.yaml -text
# Corpus threads are labelled against their exact bytes (content hash); never convert line endings.
corpus/** -text
# Git hooks run under sh, which a CRLF checkout would break.
.githooks/* text eol=lf
# New migrations keep identical hashed bytes across Windows worktrees.
# Applied migrations retain their existing checkout behavior.
migrations/0029_derived_evidence_erasure.sql text eol=lf
migrations/0030_memory_object_state_history.sql text eol=lf
migrations/0031_durable_evidence_processing.sql text eol=lf
migrations/0032_contextual_aging_policy_reader.sql text eol=lf
migrations/0033_durable_owner_initiative.sql text eol=lf
migrations/0034_goal_context_read_authority.sql text eol=lf
