# Copy to /etc/unai/worker.env (root:root 0600, ADR 0043 D6). Replace every <...>.
# Values are handles, paths or plain configuration, never credentials (ADR 0013).
# deploy/deploy.test.ts pins this list to docs/operations/environment.md.
# Optional commented assignments stay unset so their documented defaults apply.

# UNAI_GOOGLE_CONNECTOR_CLIENT: optional; handle; whole JSON secret: client_id and client_secret; required for Google sync
UNAI_GOOGLE_CONNECTOR_CLIENT=secret://mounted/google-connector-client

# UNAI_PROBE_PORT: optional; literal; unset or empty disables probes with one PROBES_DISABLED line
UNAI_PROBE_PORT=9102

# UNAI_PROBE_BIND: optional; literal; 127.0.0.1
UNAI_PROBE_BIND=127.0.0.1

# UNAI_OTEL_EXPORTER_OTLP_ENDPOINT: optional; url; unset or empty disables export and logs TELEMETRY_DISABLED
UNAI_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# UNAI_OTEL_EXPORTER_OTLP_HEADERS: optional; handle; read only with endpoint
# UNAI_OTEL_EXPORTER_OTLP_HEADERS=

# UNAI_OTEL_METRIC_EXPORT_MS: optional; literal; 60000; range 1000–3600000
# UNAI_OTEL_METRIC_EXPORT_MS=

# UNAI_DEPLOYMENT_ENVIRONMENT: optional; literal; production; lowercase token
UNAI_DEPLOYMENT_ENVIRONMENT=production

# UNAI_REGISTRY_RELEASE_ID: required; literal; see environment contract
UNAI_REGISTRY_RELEASE_ID=<registry-release-uuid>

# UNAI_REGISTRY_RELEASE: required; literal; see environment contract
UNAI_REGISTRY_RELEASE=<x.y.z>

# UNAI_PROCESSING_OWNER_SCOPE_ID: required; literal; see environment contract
UNAI_PROCESSING_OWNER_SCOPE_ID=<owner-scope-uuid>

# UNAI_PROCESSING_ACTOR_ID: required; literal; see environment contract
UNAI_PROCESSING_ACTOR_ID=<actor-uuid>

# UNAI_PROCESSING_DATA_PURPOSE: required; literal; uppercase identifier, at most 64 characters
UNAI_PROCESSING_DATA_PURPOSE=<DATA_PURPOSE>

# UNAI_PROCESSING_MAXIMUM_SENSITIVITY: required; literal; replace with NORMAL, PRIVATE or RESTRICTED
UNAI_PROCESSING_MAXIMUM_SENSITIVITY=<sensitivity-ceiling>

# UNAI_PROCESSING_POLL_MS: optional; literal; 1000; integer 100–60000
# UNAI_PROCESSING_POLL_MS=

# UNAI_CONNECTOR_SYNC_INTERVAL_MS: optional; literal; 900000 when unset or empty
# UNAI_CONNECTOR_SYNC_INTERVAL_MS=

# UNAI_RETENTION_CLEANUP_INTERVAL_MS: optional; literal; 86400000 when unset or empty
# UNAI_RETENTION_CLEANUP_INTERVAL_MS=

# UNAI_SECRETS_MOUNT: required; path; see environment contract
UNAI_SECRETS_MOUNT=/etc/unai/secrets/worker

# UNAI_MODEL_PROVIDER: required; literal; registered provider (anthropic or openai bundled)
UNAI_MODEL_PROVIDER=anthropic

# UNAI_MODEL_ENDPOINT: required; url; HTTPS provider endpoint
UNAI_MODEL_ENDPOINT=https://api.anthropic.com/v1/messages

# UNAI_MODEL_ID: required; literal; provider model ID
UNAI_MODEL_ID=claude-sonnet-5-5

# UNAI_MODEL_API_KEY: required; handle; model credential handle
UNAI_MODEL_API_KEY=secret://mounted/anthropic-api-key

# UNAI_MODEL_INPUT_MICROUNITS_PER_1K: required; literal; finite nonnegative input cost per 1000 tokens
UNAI_MODEL_INPUT_MICROUNITS_PER_1K=2000

# UNAI_MODEL_OUTPUT_MICROUNITS_PER_1K: required; literal; finite nonnegative output cost per 1000 tokens
UNAI_MODEL_OUTPUT_MICROUNITS_PER_1K=10000

# UNAI_MODEL_API_VERSION: optional; literal; anthropic defaults to 2023-06-01; unused by openai
# UNAI_MODEL_API_VERSION=

# UNAI_DATABASE_CA_FILE: required; path; trusted PostgreSQL CA
UNAI_DATABASE_CA_FILE=/etc/unai/tls/ca/ca.pem

# UNAI_APP_DATABASE_URL: required; handle; application-role URL handle
UNAI_APP_DATABASE_URL=secret://mounted/worker-database-url

# UNAI_S3_ENDPOINT: required; url; HTTPS endpoint
UNAI_S3_ENDPOINT=https://s3.<aws-region>.amazonaws.com

# UNAI_S3_REGION: required; literal; see environment contract
UNAI_S3_REGION=<aws-region>

# UNAI_S3_BUCKET: required; literal; private encrypted bucket
UNAI_S3_BUCKET=<bucket-prefix>-uai-evidence

# UNAI_S3_KMS_KEY_ID: required; literal; exact bucket/receipt key identifier
UNAI_S3_KMS_KEY_ID=arn:aws:kms:<aws-region>:<aws-account-id>:key/<evidence-key-id>

