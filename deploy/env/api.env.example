# Copy to /etc/unai/api.env (root:root 0600, ADR 0043 D6). Replace every <...>.
# Values are handles, paths or plain configuration, never credentials (ADR 0013).
# deploy/deploy.test.ts pins this list to docs/operations/environment.md.
# Optional commented assignments stay unset so their documented defaults apply.

# UNAI_GOOGLE_CONNECTOR_CLIENT: optional; handle; whole JSON secret: client_id and client_secret; required for Google sync
UNAI_GOOGLE_CONNECTOR_CLIENT=secret://mounted/google-connector-client

# UNAI_PROBE_PORT: optional; literal; unset or empty disables probes with one PROBES_DISABLED line
UNAI_PROBE_PORT=9101

# UNAI_PROBE_BIND: optional; literal; 127.0.0.1
UNAI_PROBE_BIND=127.0.0.1

# UNAI_API_RATE_LIMIT_PER_MINUTE: optional; literal; 600
# UNAI_API_RATE_LIMIT_PER_MINUTE=

# UNAI_API_AUTH_FAILURE_RATE_LIMIT_PER_MINUTE: optional; literal; 30
# UNAI_API_AUTH_FAILURE_RATE_LIMIT_PER_MINUTE=

# UNAI_OTEL_EXPORTER_OTLP_ENDPOINT: optional; url; unset or empty disables export and logs TELEMETRY_DISABLED
UNAI_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# UNAI_OTEL_EXPORTER_OTLP_HEADERS: optional; handle; read only with endpoint
# UNAI_OTEL_EXPORTER_OTLP_HEADERS=

# UNAI_OTEL_METRIC_EXPORT_MS: optional; literal; 60000; range 1000–3600000
# UNAI_OTEL_METRIC_EXPORT_MS=

# UNAI_DEPLOYMENT_ENVIRONMENT: optional; literal; production; lowercase token
UNAI_DEPLOYMENT_ENVIRONMENT=production

# UNAI_SECRETS_MOUNT: required; path; mounted provider directory
UNAI_SECRETS_MOUNT=/etc/unai/secrets/api

# UNAI_DATABASE_CA_FILE: required; path; trusted PostgreSQL CA
UNAI_DATABASE_CA_FILE=/etc/unai/tls/ca/ca.pem

# UNAI_APP_DATABASE_URL: required; handle; low-privilege application URL handle
UNAI_APP_DATABASE_URL=secret://mounted/api-database-url

# UNAI_AUTH_DATABASE_URL: required; handle; auth-role URL handle
UNAI_AUTH_DATABASE_URL=secret://mounted/auth-database-url

# UNAI_S3_ENDPOINT: required; url; HTTPS endpoint
UNAI_S3_ENDPOINT=https://s3.<aws-region>.amazonaws.com

# UNAI_S3_REGION: required; literal; see environment contract
UNAI_S3_REGION=<aws-region>

# UNAI_S3_BUCKET: required; literal; private encrypted bucket
UNAI_S3_BUCKET=<bucket-prefix>-uai-evidence

# UNAI_S3_KMS_KEY_ID: required; literal; exact bucket/receipt key identifier
UNAI_S3_KMS_KEY_ID=arn:aws:kms:<aws-region>:<aws-account-id>:key/<evidence-key-id>

# UNAI_REGISTRY_RELEASE_ID: required; literal; see environment contract
UNAI_REGISTRY_RELEASE_ID=<registry-release-uuid>

# UNAI_REGISTRY_RELEASE: required; literal; see environment contract
UNAI_REGISTRY_RELEASE=<x.y.z>

# UNAI_API_TLS_KEY_FILE: required; path; listener private-key path
UNAI_API_TLS_KEY_FILE=/etc/unai/tls/api/key.pem

# UNAI_API_TLS_CERT_FILE: required; path; listener certificate path
UNAI_API_TLS_CERT_FILE=/etc/unai/tls/api/cert.pem

# UNAI_API_PORT: optional; literal; 3443
UNAI_API_PORT=3443

# UNAI_API_BIND: optional; literal; 127.0.0.1 (loopback)
UNAI_API_BIND=127.0.0.1

