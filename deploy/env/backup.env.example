# Copy to /etc/unai/backup.env (root:root 0600). Replace every <...>.
# Values are never credentials (ADR 0013). deploy/deploy.test.ts pins this
# list to docs/operations/environment.md's pnpm backup table.
# The unit sets PGPASSFILE, AWS_SHARED_CREDENTIALS_FILE and
# AWS_EC2_METADATA_DISABLED. PGPASSWORD is refused, even when empty.

# UNAI_BACKUP_DESTINATION: required; url; encrypted archive bucket, not evidence
UNAI_BACKUP_DESTINATION=s3://<bucket-prefix>-uai-backup/<host-name>/
# UNAI_BACKUP_STAGING_DIR: required; path; existing empty directory on data volume
UNAI_BACKUP_STAGING_DIR=/var/lib/postgresql/unai-backup-staging
# UNAI_BACKUP_KEY_FILE: required; path; 32 bytes, unai-backup 0600, outside staging
UNAI_BACKUP_KEY_FILE=/etc/unai/backup/backup.key
# UNAI_BACKUP_RETENTION_DAYS: optional; literal; local directories only, refused with s3://
# UNAI_BACKUP_RETENTION_DAYS=
# UNAI_BACKUP_DATABASE_URL: required; url; password comes only from PGPASSFILE
UNAI_BACKUP_DATABASE_URL=postgresql://unai_backup@127.0.0.1:5432/unai
# UNAI_DATABASE_CA_FILE: required; path; trusted PostgreSQL CA
UNAI_DATABASE_CA_FILE=/etc/unai/tls/ca/ca.pem
# UNAI_S3_ENDPOINT: required; url; read-only evidence bucket
UNAI_S3_ENDPOINT=https://s3.<aws-region>.amazonaws.com
# UNAI_S3_REGION: required; literal; evidence region
UNAI_S3_REGION=<aws-region>
# UNAI_S3_BUCKET: required; literal; evidence bucket, never archive bucket
UNAI_S3_BUCKET=<bucket-prefix>-uai-evidence
# UNAI_S3_KMS_KEY_ID: required; literal; exact evidence key ARN
UNAI_S3_KMS_KEY_ID=arn:aws:kms:<aws-region>:<aws-account-id>:key/<evidence-key-id>
# UNAI_BACKUP_S3_ENDPOINT: required; url; backup bucket in its own region
UNAI_BACKUP_S3_ENDPOINT=https://s3.<backup-region>.amazonaws.com
# UNAI_BACKUP_S3_REGION: required; literal; different from evidence region
UNAI_BACKUP_S3_REGION=<backup-region>
# UNAI_BACKUP_S3_KMS_KEY_ID: required; literal; full backup key ARN, never alias
UNAI_BACKUP_S3_KMS_KEY_ID=arn:aws:kms:<backup-region>:<aws-account-id>:key/<backup-key-id>
# UNAI_BACKUP_PG_DUMP: optional; path; must match the PostgreSQL server major
UNAI_BACKUP_PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
