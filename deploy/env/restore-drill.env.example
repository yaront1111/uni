# Copy to /etc/unai/restore-drill.env (root:root 0600). Replace every <...>.
# Values are never credentials (ADR 0013). deploy/deploy.test.ts pins this list
# to docs/operations/environment.md's pnpm restore:drill and pnpm restore tables.
# The drill supplies UNAI_RESTORE_DATABASE_URL and UNAI_RESTORE_S3_PREFIX itself.
# Both and PGPASSWORD are refused, even when empty: never assign them here.
# The unit sets PGPASSFILE, AWS_SHARED_CREDENTIALS_FILE and AWS_EC2_METADATA_DISABLED.

# UNAI_RESTORE_DRILL_SERVER_URL: required; url; existing DB, pgpass database field *
UNAI_RESTORE_DRILL_SERVER_URL=postgresql://unai_migrator@127.0.0.1:5432/unai
# UNAI_DATABASE_CA_FILE: required; path; trusted PostgreSQL CA
UNAI_DATABASE_CA_FILE=/etc/unai/tls/ca/ca.pem
# UNAI_RESTORE_S3_ENDPOINT: required; url; drill bucket in evidence region
UNAI_RESTORE_S3_ENDPOINT=https://s3.<aws-region>.amazonaws.com
# UNAI_RESTORE_S3_REGION: required; literal; evidence region
UNAI_RESTORE_S3_REGION=<aws-region>
# UNAI_RESTORE_S3_BUCKET: required; literal; isolated drill bucket, never evidence
UNAI_RESTORE_S3_BUCKET=<bucket-prefix>-uai-restore-drill
# UNAI_RESTORE_ARCHIVE: required; url; trailing slash selects newest complete archive
UNAI_RESTORE_ARCHIVE=s3://<bucket-prefix>-uai-backup/<host-name>/
# UNAI_RESTORE_STAGING_DIR: required; path; existing empty directory on data volume
UNAI_RESTORE_STAGING_DIR=/var/lib/postgresql/unai-restore-drill-staging
# UNAI_RESTORE_ARCHIVE_S3_ENDPOINT: required; url; backup bucket endpoint
UNAI_RESTORE_ARCHIVE_S3_ENDPOINT=https://s3.<backup-region>.amazonaws.com
# UNAI_RESTORE_ARCHIVE_S3_REGION: required; literal; backup region
UNAI_RESTORE_ARCHIVE_S3_REGION=<backup-region>
# UNAI_RESTORE_KEY_FILE: required; path; original backup key, never copied into staging
UNAI_RESTORE_KEY_FILE=/etc/unai/backup/backup.key
# UNAI_RESTORE_S3_KMS_KEY_ID: required; literal; drill bucket uses evidence key
UNAI_RESTORE_S3_KMS_KEY_ID=arn:aws:kms:<aws-region>:<aws-account-id>:key/<evidence-key-id>
# UNAI_RESTORE_PG_RESTORE: optional; path; must match the PostgreSQL server major
UNAI_RESTORE_PG_RESTORE=/usr/lib/postgresql/17/bin/pg_restore
