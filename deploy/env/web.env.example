# Copy to /etc/unai/web.env (root:root 0600, ADR 0043 D6). Replace every <...>.
# Values are handles, paths or plain configuration, never credentials (ADR 0013).
# deploy/deploy.test.ts pins this list to docs/operations/environment.md.
# Optional commented assignments stay unset so their documented defaults apply.

# UNAI_OTEL_EXPORTER_OTLP_ENDPOINT: optional; url; unset or empty disables export and logs TELEMETRY_DISABLED
UNAI_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# UNAI_OTEL_EXPORTER_OTLP_HEADERS: optional; handle; read only with endpoint
# UNAI_OTEL_EXPORTER_OTLP_HEADERS=

# UNAI_OTEL_METRIC_EXPORT_MS: optional; literal; 60000; range 1000–3600000
# UNAI_OTEL_METRIC_EXPORT_MS=

# UNAI_DEPLOYMENT_ENVIRONMENT: optional; literal; production; lowercase token
UNAI_DEPLOYMENT_ENVIRONMENT=production

# NEXTAUTH_URL: required; url; canonical HTTPS origin
NEXTAUTH_URL=https://uai.<owner-domain>

# UNAI_WEB_TLS_KEY_FILE: required; path; listener private-key path
UNAI_WEB_TLS_KEY_FILE=/etc/unai/tls/web/key.pem

# UNAI_WEB_TLS_CERT_FILE: required; path; listener certificate path
UNAI_WEB_TLS_CERT_FILE=/etc/unai/tls/web/cert.pem

# UNAI_WEB_BIND: optional; literal; 127.0.0.1 (loopback)
UNAI_WEB_BIND=0.0.0.0

# UNAI_WEB_AUTH_FAILURE_RATE_LIMIT_PER_MINUTE: optional; literal; 30
# UNAI_WEB_AUTH_FAILURE_RATE_LIMIT_PER_MINUTE=

# UNAI_SECRETS_MOUNT: required; path; see environment contract
UNAI_SECRETS_MOUNT=/etc/unai/secrets/web

# UNAI_AUTH_DATABASE_URL: required; handle; auth-role URL handle; pool cached
UNAI_AUTH_DATABASE_URL=secret://mounted/auth-database-url

# UNAI_DATABASE_CA_FILE: required; path; trusted PostgreSQL CA; pool cached
UNAI_DATABASE_CA_FILE=/etc/unai/tls/ca/ca.pem

# GOOGLE_CLIENT_SECRET: required; handle; resolved each call
GOOGLE_CLIENT_SECRET=secret://mounted/google-signin-client-secret

# NEXTAUTH_SECRET: required; handle; resolved secret at least 32 characters
NEXTAUTH_SECRET=secret://mounted/nextauth-secret

# GOOGLE_CLIENT_ID: required; literal; plain OAuth client identifier
GOOGLE_CLIENT_ID=<sign-in-client-id>.apps.googleusercontent.com

# UNAI_WEB_OWNER_GOOGLE_SUBJECT: required; literal; owner's Google subject (sub), digits; the only account that can sign in
UNAI_WEB_OWNER_GOOGLE_SUBJECT=<owner-google-subject>

# UNAI_API_ORIGIN: required; url; bare HTTPS API origin; no default
UNAI_API_ORIGIN=https://127.0.0.1:3443

# UNAI_API_CA_FILE: required; path; verifies API TLS certificate
UNAI_API_CA_FILE=/etc/unai/tls/ca/ca.pem

# UNAI_OPERATIONS_REPORT_FILE: optional; path; no report if absent
# UNAI_OPERATIONS_REPORT_FILE=

# UNAI_REGISTRY_LINT_REPORT_FILE: optional; path; no lint report if absent
# UNAI_REGISTRY_LINT_REPORT_FILE=

# UNAI_CORPUS_STATUS_FILE: optional; path; no corpus status if absent
# UNAI_CORPUS_STATUS_FILE=

# UNAI_PRIVATE_CORPUS_DIR: optional; path; adds a forbidden report location; corpus/private-local always forbidden
# UNAI_PRIVATE_CORPUS_DIR=

