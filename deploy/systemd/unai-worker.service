# ADR 0043 D1-D3, D6, D8, D10-D12: distinct users, not the rejected shared unai user.
# Direct node (no pnpm wrapper) delivers SIGTERM to the process. The install task
# must make systemd's fixed executable search path resolve node to Node 24.
# Independent of unai-api: talks to PostgreSQL, S3 and the model/provider services.
# D11's backup service and D12's upgrade script explicitly order stop and start.
# PostgreSQL ordering is not a dependency: its restart must not stop this unit.
# PID 1 reads the root:root 0600 env file; connector.sync writes evidence, so the
# worker needs its own AWS credential file (D5-D6), never the API's copy.
# 180 s is the common preflight budget: API can need ten 10 s checks plus shutdown.
# No write grant: only PostgreSQL, S3 and journald receive writes; tsx uses private
# /tmp. The release is root-owned. Confirm this in the deploy rehearsal.
# Probe port 9102 is unprivileged; no capabilities are needed.
# MemoryMax is an initial placeholder for the recommended 8 GB host; rehearse/tune.
# Do not use MemoryDenyWriteExecute: V8's JIT needs writable/executable pages.
[Unit]
Description=Uai processing worker
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=exec
User=unai-worker
Group=unai-worker
WorkingDirectory=/opt/unai/current
EnvironmentFile=/etc/unai/worker.env
Environment=NODE_ENV=production
Environment=AWS_SHARED_CREDENTIALS_FILE=/etc/unai/secrets/worker/aws/credentials
Environment=AWS_EC2_METADATA_DISABLED=true
ExecStartPre=node --import tsx packages/api/src/processing-worker.ts --check
ExecStart=node --import tsx packages/api/src/processing-worker.ts
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/unai/secrets
CapabilityBoundingSet=
MemoryMax=1G

[Install]
WantedBy=multi-user.target
